{
  "name": "md2",
  "displayName": "md2 \u2014 Markdown to WeChat, Zhihu, Xiaohongshu & Threads",
  "description": "Live-preview and export Markdown for \u516c\u4f17\u53f7 (WeChat), \u77e5\u4e4e (Zhihu), \u5c0f\u7ea2\u4e66 (Xiaohongshu) image cards, X / Threads / Bluesky / LinkedIn threads, long images and covers \u2014 16 modern themes, math, Mermaid, AI copywriting.",
  "version": "0.2.10",
  "publisher": "brycewang-stanford",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#141413",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/brycewang-stanford/md2"
  },
  "homepage": "https://github.com/brycewang-stanford/md2",
  "bugs": {
    "url": "https://github.com/brycewang-stanford/md2/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Formatters",
    "Other"
  ],
  "keywords": [
    "markdown",
    "wechat",
    "\u516c\u4f17\u53f7",
    "\u5fae\u4fe1",
    "zhihu",
    "\u77e5\u4e4e",
    "xiaohongshu",
    "\u5c0f\u7ea2\u4e66",
    "rednote",
    "twitter",
    "x",
    "threads",
    "bluesky",
    "linkedin",
    "\u6392\u7248",
    "cover",
    "\u5c01\u9762",
    "mermaid",
    "latex"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:markdown",
    "onWebviewPanel:md2.preview"
  ],
  "contributes": {
    "commands": [
      {
        "command": "md2.openPreview",
        "title": "Open md2 Preview",
        "category": "md2",
        "icon": {
          "light": "media/preview-light.svg",
          "dark": "media/preview-dark.svg"
        }
      },
      {
        "command": "md2.copyWechat",
        "title": "Copy for WeChat (\u516c\u4f17\u53f7)",
        "category": "md2"
      },
      {
        "command": "md2.copyZhihu",
        "title": "Copy for Zhihu (\u77e5\u4e4e)",
        "category": "md2"
      },
      {
        "command": "md2.exportXhs",
        "title": "Export Xiaohongshu Cards (\u5c0f\u7ea2\u4e66)",
        "category": "md2"
      },
      {
        "command": "md2.copyThread",
        "title": "Copy Thread (X / Threads / Bluesky / LinkedIn)",
        "category": "md2"
      },
      {
        "command": "md2.exportLong",
        "title": "Export Long Image (\u957f\u56fe)",
        "category": "md2"
      },
      {
        "command": "md2.exportCover",
        "title": "Export Cover (\u5c01\u9762)",
        "category": "md2"
      },
      {
        "command": "md2.publishWechat",
        "title": "Publish to WeChat Drafts (\u516c\u4f17\u53f7\u8349\u7a3f\u7bb1)",
        "category": "md2"
      },
      {
        "command": "md2.setWechatCredentials",
        "title": "Set WeChat AppID / AppSecret",
        "category": "md2"
      },
      {
        "command": "md2.setZhihuCookie",
        "title": "Set Zhihu Cookie (upload images to \u77e5\u4e4e)",
        "category": "md2"
      },
      {
        "command": "md2.clearSecrets",
        "title": "Clear Stored Keys (WeChat, Zhihu & AI)",
        "category": "md2"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "md2.openPreview",
          "when": "editorLangId == markdown && !notebookEditorFocused",
          "group": "navigation@10"
        }
      ],
      "editor/context": [
        {
          "submenu": "md2.menu",
          "when": "editorLangId == markdown",
          "group": "navigation@90"
        }
      ],
      "md2.menu": [
        {
          "command": "md2.openPreview",
          "group": "1_preview"
        },
        {
          "command": "md2.copyWechat",
          "group": "2_copy@1"
        },
        {
          "command": "md2.copyZhihu",
          "group": "2_copy@2"
        },
        {
          "command": "md2.copyThread",
          "group": "2_copy@3"
        },
        {
          "command": "md2.exportXhs",
          "group": "3_export@1"
        },
        {
          "command": "md2.exportLong",
          "group": "3_export@2"
        },
        {
          "command": "md2.exportCover",
          "group": "3_export@3"
        },
        {
          "command": "md2.publishWechat",
          "group": "4_publish"
        }
      ],
      "commandPalette": [
        {
          "command": "md2.copyWechat",
          "when": "editorLangId == markdown"
        },
        {
          "command": "md2.copyZhihu",
          "when": "editorLangId == markdown"
        },
        {
          "command": "md2.exportXhs",
          "when": "editorLangId == markdown"
        },
        {
          "command": "md2.copyThread",
          "when": "editorLangId == markdown"
        },
        {
          "command": "md2.exportLong",
          "when": "editorLangId == markdown"
        },
        {
          "command": "md2.exportCover",
          "when": "editorLangId == markdown"
        },
        {
          "command": "md2.publishWechat",
          "when": "editorLangId == markdown"
        }
      ]
    },
    "submenus": [
      {
        "id": "md2.menu",
        "label": "md2"
      }
    ],
    "keybindings": [
      {
        "command": "md2.openPreview",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorLangId == markdown"
      }
    ],
    "configuration": {
      "title": "md2",
      "properties": {
        "md2.exportFolder": {
          "type": "string",
          "default": "md2-export",
          "description": "Folder (relative to the Markdown file) where images and HTML are saved."
        },
        "md2.revealAfterExport": {
          "type": "boolean",
          "default": true,
          "description": "Offer to reveal exported files in the OS file manager."
        },
        "md2.wechat.coverTemplate": {
          "type": "string",
          "default": "aurora",
          "enum": [
            "aurora",
            "glass",
            "claude",
            "bento",
            "swiss",
            "brutal",
            "terminal",
            "notes",
            "editorial",
            "photo"
          ],
          "description": "Cover template used when publishing an article that has no cover image."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "package": "node build.mjs && vsce package --no-dependencies",
    "test": "node test/run.mjs",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@md2/core": "workspace:*"
  }
}
